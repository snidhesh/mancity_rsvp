# --- BlackOak internal CRM (studio.blackoak-re.com lead intake) ---
# Create a NEW lead-intake key for this campaign in Studio
# (Integrations → Lead intake keys) with its own source label, e.g.
# "MCFC Yas Residences Ph2 RSVP". The CRM stamps every lead's `source`
# from the key, so reusing another campaign's key mislabels the leads.
BLACKOAK_CRM_URL=https://studio.blackoak-re.com/api/v1/public/intake/leads
BLACKOAK_CRM_TOKEN=

# --- Resend (branded confirmation email + .ics sent after form submit) ---
# Domain in RESEND_FROM must be verified in Resend before sends will deliver.
RESEND_API_KEY=
RESEND_FROM="Manchester City Yas Residences <invitation@blackoak-re.com>"

# --- Browser origins allowed to POST to /api/invitation (comma-separated).
#     Locally add http://localhost:3002.
ALLOWED_ORIGINS=https://www.blackoak-re.com,https://blackoak-re.com,https://mancityrsvp.vercel.app

# --- Public: base path prefix so this app can be served under a parent domain
#     sub-path (blackoak-re.com/yas_residences_rsvp). Set to
#     "/yas_residences_rsvp" in Vercel production/preview. Leave blank locally.
NEXT_PUBLIC_BASE_PATH=
